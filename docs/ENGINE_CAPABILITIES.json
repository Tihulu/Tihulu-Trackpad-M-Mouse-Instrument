{
  "schema": 1,
  "status": "experimental",
  "scope": "candidate source capabilities, not runtime or release acceptance",
  "products": [
    {
      "name": "NoSpeakerCore",
      "kind": "swift-library",
      "platform": "portable core",
      "path": "studio/Sources/NoSpeakerCore"
    },
    {
      "name": "NoSpeakerMac",
      "kind": "swift-library",
      "platform": "macOS native only",
      "path": "studio/Sources/NoSpeakerMac"
    },
    {
      "name": "tihulu-mac-instrument-engine",
      "kind": "json-cli",
      "platform": "SwiftPM offline",
      "path": "studio/Sources/TihuluEngineCLI/CLI.swift"
    }
  ],
  "features": [
    {
      "id": "sensor-routing",
      "api": [
        "SensorRouter",
        "InstrumentPatch",
        "PatchSimulation"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/SensorRouter.swift",
        "studio/Sources/NoSpeakerCore/InstrumentPatch.swift"
      ],
      "cli": [
        "patch example",
        "patch validate",
        "patch routes"
      ],
      "status": "offline-core"
    },
    {
      "id": "group-routing",
      "api": [
        "PerformanceGroupProfile",
        "PerformanceGroupRouter",
        "PerformanceGroupDelivery",
        "PerformanceGroupEndpointPlan"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/PerformanceGroupProfile.swift",
        "studio/Sources/NoSpeakerCore/PerformanceGroupRouter.swift",
        "studio/Sources/NoSpeakerCore/PerformanceGroupDelivery.swift",
        "studio/Sources/NoSpeakerCore/PerformanceGroupEndpointPlan.swift"
      ],
      "cli": [
        "groups example",
        "groups validate",
        "groups ports",
        "groups simulate"
      ],
      "status": "offline-core; no native group registration in this branch"
    },
    {
      "id": "sustain-helper",
      "api": [
        "LegacySustainOwners",
        "LegacyContinuousOwners",
        "HelperRoutingSnapshot"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/LegacySustainOwners.swift",
        "studio/Sources/NoSpeakerCore/LegacyContinuousOwners.swift",
        "studio/Sources/NoSpeakerCore/HelperRoutingSnapshot.swift"
      ],
      "cli": [
        "sustain simulate",
        "helper simulate"
      ],
      "status": "offline sustain and expressive ownership simulation; no live MIDI"
    },
    {
      "id": "tuning-mpe",
      "api": [
        "AirTunedOutput",
        "CustomScale"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/AirTunedOutput.swift",
        "studio/Sources/NoSpeakerCore/CustomScale.swift"
      ],
      "cli": [
        "scale plan"
      ],
      "status": "offline pitch planning; separate group MPE not implemented"
    },
    {
      "id": "haptic-mixing",
      "api": [
        "HapticFrameMixer"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/HapticFrameMixer.swift"
      ],
      "cli": [
        "haptics mix"
      ],
      "status": "offline frame mix preview; hardware CLI planned"
    },
    {
      "id": "native-midi-touch",
      "api": [
        "MIDIHapticService",
        "ChordMIDIOutput"
      ],
      "source": [
        "studio/Sources/NoSpeakerMac/MIDIHapticService.swift",
        "studio/Sources/NoSpeakerMac/TouchInstrumentService.swift"
      ],
      "cli": [],
      "status": "native-library; requires permissions and lifecycle acceptance"
    },
    {
      "id": "daw-setup",
      "api": [
        "DAWSetupProjection"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/DAWSetupProjection.swift",
        "studio/Sources/NoSpeakerStudio/DAWSetupAssistantView.swift"
      ],
      "cli": [
        "patch routes",
        "groups ports"
      ],
      "status": "read-only logical setup; no receiver confirmation"
    },
    {
      "id": "source-retrieval",
      "api": [],
      "source": [
        "tools/repo_index.py"
      ],
      "cli": [
        "build",
        "search",
        "verify"
      ],
      "status": "commit-pinned lexical retrieval and source verification; semantic requires trusted local model"
    },
    {
      "id": "midi-file",
      "api": [
        "MIDIClip",
        "MIDIClipWriter",
        "NoteSequence",
        "DrumSequence",
        "TunedMIDIClip",
        "GrooveSettings"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/MIDIClip.swift",
        "studio/Sources/NoSpeakerCore/Sequencer.swift",
        "studio/Sources/NoSpeakerCore/TunedMIDIClip.swift",
        "studio/Sources/NoSpeakerCore/GrooveSettings.swift"
      ],
      "cli": [
        "midi encode",
        "midi melody",
        "midi drums",
        "midi tuned",
        "midi groove"
      ],
      "status": "offline SMF0 nominal and dedicated single-instrument MPE exports; no live MIDI"
    },
    {
      "id": "voice-analysis",
      "api": [
        "HapticVoiceAnalyzer",
        "HapticVoiceFrame"
      ],
      "source": [
        "studio/Sources/NoSpeakerCore/VoiceAnalysis.swift"
      ],
      "cli": [
        "voice analyze"
      ],
      "status": "offline normalized mono PCM analysis and haptic frame data; no synthesis, recording or hardware"
    }
  ],
  "constraints": {
    "automaticHardwareActivation": false,
    "defaultNetworkAccess": false,
    "stableAPI": false,
    "receiverConfirmation": false,
    "physicalAcceptance": "separate",
    "license": "MIT with upstream attribution; additional dependency and model licenses may differ"
  },
  "externalExample": "examples/EngineConsumer"
}
